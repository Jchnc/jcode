@@COPILOT_LINK_HELPER@@

rm -f /usr/bin/@@NAME@@

case "$1" in
	remove|purge)
		# Load debconf so the other edition's add-copilot-command answer is respected before handing the link over.
		if [ -e '/usr/share/debconf/confmodule' ]; then
			. /usr/share/debconf/confmodule
		fi
		vscode_copilot_link remove "@@NAME@@" || :
		;;
esac

# Uninstall the desktop entry
if hash update-desktop-database 2>/dev/null; then
	update-desktop-database
fi

# Update mimetype database for removed workspace mimetype
if hash update-mime-database 2>/dev/null; then
	update-mime-database /usr/share/mime
fi

# JCode never registers an apt repository, so it must not remove the Microsoft
# VS Code repository or keyring that a separate VS Code installation may use.
